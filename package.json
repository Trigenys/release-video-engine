{
  "name": "release-video-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "typecheck:video": "tsc -p tsconfig.video.json --noEmit",
    "render:agenfetch": "node scripts/render-agenfetch.mjs",
    "render:agenfetch:vertical": "remotion render video/index.ts AgenFetchRelease-v031 out/agenfetch-v0.3.1-vertical.mp4 --codec=h264 --crf=20 --concurrency=2",
    "validate:ingestion": "tsx scripts/validate-release-ingestion.mts",
    "typecheck:functions": "tsc -p tsconfig.functions.json --noEmit",
    "validate:funnel": "tsx scripts/validate-early-access.mts",
    "render:showcases": "node scripts/render-showcase-previews.mjs",
    "validate:showcases": "tsx scripts/validate-showcases.mts",
    "validate:templates": "tsx scripts/validate-template-registry.mts",
    "qa:landing": "playwright test",
    "qa:budget": "node scripts/check-web-budget.mjs",
    "qa": "npm run build && npm run qa:budget && npm run qa:landing",
    "render:formbricks": "node scripts/render-formbricks.mjs",
    "build:hyperframes:formbricks": "tsx scripts/build-hyperframes-formbricks.mts",
    "check:hyperframes:formbricks": "npx --yes hyperframes@0.8.62 check hyperframes/formbricks-6.0.1/vertical && npx --yes hyperframes@0.8.62 check hyperframes/formbricks-6.0.1/square && npx --yes hyperframes@0.8.62 check hyperframes/formbricks-6.0.1/landscape",
    "render:hyperframes:formbricks": "node scripts/render-hyperframes-formbricks.mjs",
    "benchmark:hyperframes:formbricks": "npm run build:hyperframes:formbricks && npm run check:hyperframes:formbricks && npm run render:hyperframes:formbricks"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "remotion": "4.0.528",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.8.3",
    "vite": "^7.1.7",
    "@remotion/cli": "4.0.528",
    "tsx": "^4.20.0",
    "@cloudflare/workers-types": "5.20260926.1",
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.10.2"
  }
}
