{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "release-video-engine",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-27",
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "LEADS_DB",
          "database_name": "release-video-engine-leads",
