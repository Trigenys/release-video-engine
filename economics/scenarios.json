        {
          "format": "square",
          "locale": "en"
        }
      ],
      "releasesPerCustomerMonth": 1
    },
    {
      "id": "single-landscape-en",
      "description": "One 16:9 English output.",
      "outputs": [
        {
          "format": "landscape",
          "locale": "en"
        }
      ],
      "releasesPerCustomerMonth": 1
    },
    {
      "id": "launch-pack-3-formats-en",
      "description": "One release rendered to 9:16, 1:1 and 16:9 English outputs in one job.",
